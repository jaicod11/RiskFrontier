# Copy to .env and adjust. docker-compose reads this file automatically.

# --- Postgres --------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=portfolio_risk
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Overrides the POSTGRES_* values above when set. Use this for a managed DB.
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/portfolio_risk

# --- Backend ---------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Regex alternative for origins not known ahead of time — Vercel gives every
# preview deployment its own subdomain. Set this in the deployed environment
# instead of editing code.
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# --- Frontend --------------------------------------------------------------
# Vite only exposes variables prefixed with VITE_. Lives in frontend/.env.
VITE_API_BASE_URL=http://localhost:8000
