# Copy to .env and adjust. docker-compose reads this file automatically.

# --- Postgres --------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=portfolio_risk
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Overrides the POSTGRES_* values above when set. Use this for a managed DB.
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/portfolio_risk

# --- Backend ---------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Regex alternative for origins not known ahead of time — Vercel gives every
# preview deployment its own subdomain. Set this in the deployed environment
# instead of editing code.
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# --- Frontend --------------------------------------------------------------
# Vite only exposes variables prefixed with VITE_. Lives in frontend/.env.
VITE_API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Production only (set in the Render dashboard, not committed)
# ---------------------------------------------------------------------------
# ENVIRONMENT=production makes the app refuse to boot if DATABASE_URL or a
# non-localhost CORS origin is missing, rather than silently falling back to a
# local database that does not exist in production.
# ENVIRONMENT=production
# DEBUG=false

# Neon POOLED connection string (host contains "-pooler"), used by the app.
# DATABASE_URL=postgresql://user:pass@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Neon DIRECT connection string, used by Alembic only. The pooled endpoint uses
# transaction pooling and does not preserve the session state migrations need.
# Leave unset locally: docker-compose has one Postgres and no pooling split.
# DATABASE_URL_UNPOOLED=postgresql://user:pass@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# DB_REQUIRE_SSL=true

# Connection pool, sized for serverless Postgres behind a 512 MB instance.
# DB_POOL_SIZE=3
# DB_MAX_OVERFLOW=2
# DB_POOL_RECYCLE_SECONDS=280
# DB_CONNECT_TIMEOUT_SECONDS=15

# The deployed frontend origin. A regex also covers Vercel preview URLs.
# CORS_ORIGIN_REGEX=https://riskfrontier.*\.vercel\.app

# Request budgets, lowered for a shared-CPU free instance. See core/limits.py
# for the measured timings behind each value.
# MAX_N_SIMS=50000
# MAX_BOOTSTRAP_RESAMPLES=300
# MAX_WALK_FORWARD_BLOCK_RESAMPLES=15

# Server
# WEB_CONCURRENCY=1
# GUNICORN_TIMEOUT=120
